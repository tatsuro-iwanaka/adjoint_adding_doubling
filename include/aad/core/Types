class RadiativeLayer
{
	public:
		std::vector<Eigen::MatrixXd> reflectance_m_top_cos;
		std::vector<Eigen::MatrixXd> reflectance_m_bottom_cos;
		std::vector<Eigen::MatrixXd> transmittance_m_top_cos;
		std::vector<Eigen::MatrixXd> transmittance_m_bottom_cos;

		std::vector<Eigen::MatrixXd> reflectance_m_top_sin;
		std::vector<Eigen::MatrixXd> reflectance_m_bottom_sin;
		std::vector<Eigen::MatrixXd> transmittance_m_top_sin;
		std::vector<Eigen::MatrixXd> transmittance_m_bottom_sin;

		Eigen::MatrixXd source_up;
		Eigen::MatrixXd source_down;

		int n_doubling;

		bool enable_atmospheric_emission = true;
		bool is_surface = true;

		double optical_thickness; //dimensionless

		void resize(int n_theta, int n_mode)
		{
			reflectance_m_top_cos.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			reflectance_m_bottom_cos.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			transmittance_m_top_cos.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			transmittance_m_bottom_cos.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));

			reflectance_m_top_sin.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			reflectance_m_bottom_sin.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			transmittance_m_top_sin.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));
			transmittance_m_bottom_sin.resize(n_mode + 1, Eigen::MatrixXd::Zero(n_theta, n_theta));

			source_up = Eigen::VectorXd::Zero(n_theta);
			source_down = Eigen::VectorXd::Zero(n_theta);

			return;
		}

		void clear(void)
		{
			reflectance_m_top_cos.clear();
			reflectance_m_bottom_cos.clear();
			transmittance_m_top_cos.clear();
			transmittance_m_bottom_cos.clear();

			reflectance_m_top_sin.clear();
			reflectance_m_bottom_sin.clear();
			transmittance_m_top_sin.clear();
			transmittance_m_bottom_sin.clear();

			source_up.resize(0, 0);
			source_down.resize(0, 0);

			return;
		}

};

