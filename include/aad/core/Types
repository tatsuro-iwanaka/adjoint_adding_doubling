struct OpticalSensitivity
{
	double optical_thickness;
	double single_scattering_albedo;
	double plank_function;
	std::vector<std::vector<double>> scattering_phase_function;

	void zero(void)
	{
		optical_thickness = 0.0;
		single_scattering_albedo = 0.0;
		plank_function = 0.0;
		
		for (auto& row : scattering_phase_function)
		{
			std::fill(row.begin(), row.end(), 0.0);
		}
	}
};


